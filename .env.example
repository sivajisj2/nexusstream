# Copy to .env for Docker Compose; generate a random key with scripts/setup.sh.
NEXUS_API_KEY=replace-with-a-random-key-of-at-least-32-bytes
POSTGRES_PASSWORD=replace-with-a-random-database-password
DATABASE_URL=postgres://nexus:replace-with-a-random-database-password@localhost:5432/nexus
NEXUS_BIND=127.0.0.1:8080
RUST_LOG=info
